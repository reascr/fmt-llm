#!/bin/bash
#$ -N fmt-baseline
#$ -cwd
#$ -q cuda.q
#$ -S /bin/bash
#$ -o logs
#$ -e logs
#$ -M YOUR_MPI_EMAIL
#$ -m bea

# Clean the module environment
module purge
unset PYTHONHOME
unset PYTHONPATH

# Python version required by fmt-llm
module load python/3.9.4

# Activate existing environment
source /home/andsch1/.venvs/fmt-llm/bin/activate

# Go to the repository
cd /home/andsch1/fmt-llm

echo "Job $JOB_ID started at $(date)"
echo "Running on $(hostname)"
python --version

# Run the baseline experiment
python -u train.py config=config/dev_fleeting_memory_mask_with_echoic_config.py # unbuffered output

echo "Job $JOB_ID finished at $(date)"